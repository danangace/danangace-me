---
import { background } from '../data/background'
---

<section class="look" aria-labelledby="look-title" data-tabs>
  <h2 id="look-title">A closer look.</h2>

  <div class="nav-wrap">
    <div class="tablist" role="tablist" aria-label="Background">
      <span class="pill" aria-hidden="true"></span>
      {background.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {t.label}
        </button>
      ))}
    </div>
  </div>

  <div class="panels">
    {background.map((t, i) => (
      <div
        class="panel"
        role="tabpanel"
        id={`panel-${t.id}`}
        aria-labelledby={`tab-${t.id}`}
        data-active={i === 0 ? '' : undefined}
      >
        <h3 class="panel-title">{t.label}</h3>
        {t.entries.length ? (
          <ul class={`entries ${t.layout}`}>
            {t.entries.map((e) => (
              <li>
                <div class="row">
                  {e.url ? (
                    <a
                      class="title"
                      href={e.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {e.title}
                    </a>
                  ) : (
                    <span class="title">{e.title}</span>
                  )}
                  {e.period && <span class="period">{e.period}</span>}
                </div>
                {e.subtitle && <p class="sub">{e.subtitle}</p>}
                {e.note && <p class="note">{e.note}</p>}
                {e.points && (
                  <ul class="points">
                    {e.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">{t.empty}</p>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .look {
    padding: 0 var(--gutter);
  }
  h2 {
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  /* Without JavaScript every panel is visible and the switcher is hidden. */
  .nav-wrap {
    display: none;
  }
  .panel {
    margin-top: 2rem;
  }
  .panel-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--muted);
  }

  [data-ready] .nav-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  [data-ready] .panel-title {
    display: none;
  }
  [data-ready] .panels {
    margin-top: 2rem;
  }
  [data-ready] .panel {
    display: none;
    margin-top: 0;
  }
  [data-ready] .panel[data-active] {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-ready] .panel[data-active] {
      animation: panel-in 350ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    @keyframes panel-in {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
    }
  }

  /* Segmented control with a sliding pill, like the one on apple.com. */
  .tablist {
    position: relative;
    display: flex;
    gap: 0.25rem;
    max-width: 100%;
    padding: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .tablist::-webkit-scrollbar {
    display: none;
  }
  .pill {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pill {
      transition:
        transform 350ms cubic-bezier(0.32, 0.72, 0, 1),
        width 350ms cubic-bezier(0.32, 0.72, 0, 1);
    }
  }
  button {
    position: relative;
    flex: none;
    padding: 0.55rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition: color 150ms ease-out;
  }
  button:hover,
  button[aria-selected='true'] {
    color: var(--ink);
  }

  /* Panel content: two columns when there is room, so long lists stay short. */
  .entries {
    list-style: none;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1rem, 2vw, 1.75rem) clamp(1.25rem, 3vw, 2.5rem);
    border-radius: clamp(1.25rem, 2.4vw, 1.75rem);
    background: var(--surface);
  }
  .entries.grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .entries > li {
    padding: 1.25rem 0;
  }
  .entries.list > li + li {
    border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .points {
    font-size: 0.9375rem;
    list-style: disc;
    max-width: 46rem;
    margin: 0.85rem 0 0;
    padding: 0 0 0 1.1rem;
    display: grid;
    gap: 0.4rem;
  }
  .points li {
    padding: 0;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }
  .title {
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: inherit;
    text-decoration: none;
  }
  a.title:hover {
    color: var(--muted);
  }
  .period,
  .sub {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .sub {
    margin-top: 0.25rem;
  }
  .note {
    max-width: 40rem;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
    margin-top: 0.5rem;
  }
  .empty {
    padding: 2rem clamp(1.25rem, 3vw, 2.5rem);
    border-radius: clamp(1.25rem, 2.4vw, 1.75rem);
    background: var(--surface);
    color: var(--muted);
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      if (root.dataset.ready !== undefined) return
      const list = root.querySelector<HTMLElement>('[role="tablist"]')!
      const pill = list.querySelector<HTMLElement>('.pill')!
      const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
      const panels = tabs.map((t) =>
        root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!,
      )

      const movePill = (tab: HTMLElement) => {
        pill.style.width = `${tab.offsetWidth}px`
        pill.style.transform = `translateX(${tab.offsetLeft}px)`
      }

      const select = (index: number, focus = false) => {
        tabs.forEach((t, i) => {
          const on = i === index
          t.setAttribute('aria-selected', String(on))
          t.tabIndex = on ? 0 : -1
          panels[i].toggleAttribute('data-active', on)
        })
        movePill(tabs[index])
        tabs[index].scrollIntoView({ block: 'nearest', inline: 'nearest' })
        if (focus) tabs[index].focus()
      }

      tabs.forEach((t, i) => t.addEventListener('click', () => select(i)))
      list.addEventListener('keydown', (e) => {
        const cur = tabs.findIndex(
          (t) => t.getAttribute('aria-selected') === 'true',
        )
        const last = tabs.length - 1
        const next =
          e.key === 'ArrowRight'
            ? cur === last
              ? 0
              : cur + 1
            : e.key === 'ArrowLeft'
              ? cur === 0
                ? last
                : cur - 1
              : e.key === 'Home'
                ? 0
                : e.key === 'End'
                  ? last
                  : -1
        if (next < 0) return
        e.preventDefault()
        select(next, true)
      })

      root.dataset.ready = ''
      // Place the pill without animating on first paint.
      pill.style.transition = 'none'
      movePill(tabs[0])
      requestAnimationFrame(() => (pill.style.transition = ''))
      new ResizeObserver(() => {
        const cur = tabs.find(
          (t) => t.getAttribute('aria-selected') === 'true',
        )!
        pill.style.transition = 'none'
        movePill(cur)
        requestAnimationFrame(() => (pill.style.transition = ''))
      }).observe(list)
    })
  }
  document.addEventListener('astro:page-load', init)
</script>
