---
// A quiet list: big title, one line of context, hairline between rows.
interface Item {
  href?: string
  external?: boolean
  title: string
  meta?: string
  note?: string
}
interface Props {
  items: Item[]
}
---

<ul class="list">
  {Astro.props.items.map((item) => (
    <li>
      {item.href ? (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          <span class="title">{item.title}</span>
          {item.meta && <span class="meta">{item.meta}</span>}
        </a>
      ) : (
        <div>
          <span class="title">{item.title}</span>
          {item.meta && <span class="meta">{item.meta}</span>}
        </div>
      )}
      {item.note && <p>{item.note}</p>}
    </li>
  ))}
</ul>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter);
  }
  li {
    padding: 1.5rem 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  a,
  li > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    color: inherit;
    text-decoration: none;
  }
  .title {
    font-size: clamp(1.5rem, 3.4vw, 2.75rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  a:hover .title {
    color: var(--accent);
  }
  .meta {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  p {
    max-width: 36rem;
    margin-top: 0.5rem;
    color: var(--muted);
  }
</style>
