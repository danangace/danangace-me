---
import DMark from './DMark.astro'
import { profile } from '../data/profile'

const path = Astro.url.pathname
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`)
const github = profile.socials.find((s) => s.label === 'GitHub')
---

<header class="nav">
  <a href="/" class="mark" aria-label="Danang Putra Bahari, home">
    <DMark class="mark-svg" />
  </a>
  <nav aria-label="Primary">
    {profile.nav.map((l) => (
      <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
    {github && (
      <a href={github.url} target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
    )}
  </nav>
</header>

<style>
  /* Translucent layer: page content scrolls underneath it. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    padding: 0 var(--gutter);
    background: var(--nav-bg);
    backdrop-filter: blur(20px) saturate(180%);
  }
  .mark {
    display: block;
  }
  :global(.mark-svg) {
    display: block;
    height: 1.5rem;
  }
  nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.875rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 150ms ease-out;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  @media (prefers-reduced-transparency: reduce) {
    .nav {
      background: var(--bg);
      backdrop-filter: none;
    }
  }
</style>
