---
interface Props {
  title: string
  lead?: string
}

const { title, lead } = Astro.props
---

<header class="page-header">
  <h1>{title}</h1>
  {lead && <p>{lead}</p>}
</header>

<style>
  .page-header {
    padding: clamp(4rem, 14vh, 9rem) var(--gutter) clamp(2rem, 6vh, 4rem);
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  p {
    max-width: 32rem;
    margin-top: 1.5rem;
    font-size: clamp(1.0625rem, 1.4vw, 1.375rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--muted);
  }
</style>
