---
interface Props {
  title: string
  lead?: string
}

const { title, lead } = Astro.props
---

<header class="page-header">
  <h1>{title}</h1>
  {lead && <p>{lead}</p>}
</header>

<style>
  .page-header {
    padding: clamp(4rem, 14vh, 9rem) var(--gutter) clamp(2rem, 6vh, 4rem);
  }
  h1 {
    font-size: clamp(3rem, 9vw, 8rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.048em;
  }
  p {
    max-width: 32rem;
    margin-top: 1.5rem;
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--muted);
  }
</style>
