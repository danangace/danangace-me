---
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getBlogs } from '../../lib/content'

export async function getStaticPaths() {
  const posts = await getBlogs()
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const fmt = new Intl.DateTimeFormat('en', { dateStyle: 'long' })
---

<BaseLayout
  title={`${post.data.title} - Danang Putra Bahari`}
  description={post.data.description}
>
  <article class="post">
    <a class="back" href="/blogs">
      Blog
    </a>
    <h1>{post.data.title}</h1>
    <p class="date">
      <time datetime={post.data.date.toISOString()}>
        {fmt.format(post.data.date)}
      </time>
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding: clamp(3rem, 10vh, 6rem) var(--gutter) 0;
    max-width: 46rem;
  }
  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .back:hover {
    color: var(--ink);
  }
  h1 {
    margin-top: 1.5rem;
    font-size: clamp(2rem, 4.6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .date {
    margin-top: 1rem;
    color: var(--muted);
  }
  .prose {
    margin-top: 3rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .prose :global(> * + *) {
    margin-top: 1.25em;
  }
  .prose :global(h2) {
    margin-top: 2em;
    font-size: 1.75rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 0.35em;
    background: var(--surface);
    font-size: 0.9em;
  }
  .prose :global(pre) {
    padding: 1.25rem;
    border-radius: 1rem;
    overflow-x: auto;
    font-size: 0.9375rem;
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
  }
</style>
