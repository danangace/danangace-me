---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHeader from '../../components/PageHeader.astro'
import EntryList from '../../components/EntryList.astro'
import EmptyState from '../../components/EmptyState.astro'
import { getBlogs } from '../../lib/content'

const posts = await getBlogs()
const fmt = new Intl.DateTimeFormat('en', { dateStyle: 'medium' })
---

<BaseLayout
  title="Blog - Danang Putra Bahari"
  description="Notes on frontend development and what I'm learning."
>
  <PageHeader title="Blog" lead="Notes on frontend and what I'm learning." />
  {posts.length ? (
    <EntryList
      items={posts.map((p) => ({
        href: `/blogs/${p.id}`,
        title: p.data.title,
        meta: fmt.format(p.data.date),
        note: p.data.description,
      }))}
    />
  ) : (
    <EmptyState message="The first post is still being written." />
  )}
</BaseLayout>
