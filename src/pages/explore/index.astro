---
import ExploreLayout from '../../layouts/ExploreLayout.astro'

const directions = [
  {
    href: '/explore/a',
    name: 'Still',
    text: 'Apple-like calm. Huge tight type, a translucent nav, and a statement that lights up word by word as you scroll. The D settles into place once, on load.',
  },
  {
    href: '/explore/b',
    name: 'Chapters',
    text: 'Full-screen colour chapters that stack over each other like pages. Condensed display type, and every tool is a link inside a sentence.',
  },
  {
    href: '/explore/c',
    name: 'Tactile',
    text: 'The D falls apart into pieces you drag back together, with real momentum, rubber-banding and snapping. Quiet reading column below.',
  },
]
---

<ExploreLayout title="Design directions">
  <main>
    <h1>Pick a direction</h1>
    <p class="sub">
      Three prototypes of the home page, using your real content. Open each on
      desktop and on your phone.
    </p>
    <ul>
      {directions.map((d) => (
        <li>
          <a href={d.href}>
            <span class="name">{d.name}</span>
            <span class="text">{d.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</ExploreLayout>

<style is:global>
  body {
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      sans-serif;
    background: #f5f5f7;
    color: #1d1d1f;
    line-height: 1.5;
  }
</style>

<style>
  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(3rem, 12vh, 7rem) 1.25rem;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3.25rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .sub {
    margin-top: 0.75rem;
    color: #6e6e73;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 0.5rem;
  }
  a {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    background: #fff;
    text-decoration: none;
    transition: transform 120ms ease-out;
  }
  a:hover {
    transform: translateY(-1px);
  }
  a:active {
    transform: scale(0.99);
  }
  .name {
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .text {
    color: #6e6e73;
  }
</style>
