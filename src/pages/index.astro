---
import BaseLayout from '../layouts/BaseLayout.astro'
import DMark from '../components/DMark.astro'
import CloserLook from '../components/CloserLook.astro'
import { profile } from '../data/profile'

// Split the statement at build time so each word can light up on scroll.
const words = profile.passion.split(' ')
---

<BaseLayout>
  <section class="hero">
    <div class="hero-text">
      <DMark class="hero-mark" />
      <p class="greeting">Hello, I'm</p>
      <h1>{profile.name}</h1>
      <p class="hero-intro">{profile.intro}</p>
      <p class="hero-links">
        {profile.nav.map((l) => (
          <a href={l.href}>
            {l.label}
            <span aria-hidden="true">›</span>
          </a>
        ))}
      </p>
    </div>
  </section>

  <section class="statement" aria-label="What drives me">
    <p class="reveal" style={`--n:${words.length}`}>
      {words.map((w, i) => (
        <>
          <span style={`--i:${i}`}>{w}</span>{' '}
        </>
      ))}
    </p>
  </section>

  <CloserLook />

  <section class="life" aria-label="Outside of work">
    <p>{profile.offline}</p>
    <p class="life-links">
      <a href={profile.links.books}>Books I'm listing</a>
      <a href={profile.links.tools}>Hardware and software I use</a>
    </p>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--nav-height));
    padding: 0 var(--gutter) clamp(2rem, 8vh, 5rem);
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .greeting {
    font-size: clamp(1.0625rem, 1.6vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--muted);
  }
  h1 {
    margin-top: 0.35rem;
    font-size: clamp(2.5rem, 6.4vw, 5.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero-intro {
    max-width: 34rem;
    margin-top: 1rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .hero-links {
    display: flex;
    gap: 1.75rem;
    margin-top: 1.25rem;
    font-size: clamp(1.0625rem, 1.4vw, 1.3rem);
  }
  .hero-links a {
    color: var(--ink);
    text-decoration: none;
  }
  .hero-links a span {
    margin-left: 0.3em;
  }
  .hero-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  :global(.hero-mark) {
    height: clamp(4.5rem, 11vh, 7.5rem);
    margin-bottom: clamp(1.25rem, 3.5vh, 2.25rem);
    color: var(--accent);
  }

  /* The one orchestrated moment: the three parts of the D settle into place. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.hero-mark path) {
      transform-box: fill-box;
      animation: settle 1.3s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    :global(.hero-mark .bar) {
      --from: translateY(-115%);
    }
    :global(.hero-mark .ring) {
      --from: translateX(-35%) scale(0.92);
      animation-delay: 120ms;
    }
    :global(.hero-mark .pill) {
      --from: translateX(-260%);
      animation-delay: 260ms;
    }
    @keyframes settle {
      from {
        transform: var(--from);
        opacity: 0;
      }
      40% {
        opacity: 1;
      }
      to {
        transform: none;
        opacity: 1;
      }
    }
  }

  /* ---------- Statement: words light up with scroll ---------- */
  .statement {
    padding: clamp(6rem, 24vh, 14rem) var(--gutter);
  }
  .reveal {
    max-width: 21em;
    font-size: clamp(1.5rem, 3.2vw, 2.75rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* One timeline for the whole paragraph; each word takes its own slice of
         the scroll distance, so words light up in reading order. */
      .reveal {
        view-timeline: --reveal block;
      }
      .reveal span {
        opacity: 0.16;
        /* Longhands on purpose: the minifier folds them into an `animation: … view()`
           shorthand that Chrome drops. */
        animation-name: lit;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --reveal;
        animation-range: cover calc(6% + var(--i) * (34% / var(--n))) cover
          calc(14% + var(--i) * (34% / var(--n)));
      }
      @keyframes lit {
        to {
          opacity: 1;
        }
      }
    }
  }

  /* ---------- Outside of work ---------- */
  .life {
    padding: clamp(4rem, 12vh, 8rem) var(--gutter) 0;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }
  .life p {
    max-width: 30rem;
  }
  .life-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 1.5rem;
  }
  .life-links a {
    width: fit-content;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--muted);
  }
</style>
