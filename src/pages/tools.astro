---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHeader from '../components/PageHeader.astro'
import EntryList from '../components/EntryList.astro'
import EmptyState from '../components/EmptyState.astro'

const tools = await getCollection('tools')
---

<BaseLayout
  title="Tools - Danang Putra Bahari"
  description="The hardware and software I use every day."
>
  <PageHeader title="Tools" lead="The hardware and software I use." />
  {tools.length ? (
    <EntryList
      items={tools.map(({ data: t }) => ({
        href: t.url,
        external: true,
        title: t.name,
        meta: t.kind === 'hardware' ? 'Hardware' : 'Software',
        note: t.note,
      }))}
    />
  ) : (
    <EmptyState message="The list of gear and apps is still being put together." />
  )}
</BaseLayout>
